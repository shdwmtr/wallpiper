cc := env_var_or_default("CC", "cc")
cflags := env_var_or_default("CFLAGS", "-std=gnu99 -O2 -Wall -Wextra -fPIC -fvisibility=hidden -D_GNU_SOURCE")
target_dir := "../target/release"
obj_dir := "../target/objects"
so := target_dir / "libwallpiper-preload.so"

build:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{target_dir}}
    objs=()
    while IFS= read -r src; do
        obj="{{obj_dir}}/${src%.c}.o"
        mkdir -p "$(dirname "$obj")"
        {{cc}} {{cflags}} -c -o "$obj" "$src"
        objs+=("$obj")
    done < <(find src -name '*.c')
    {{cc}} {{cflags}} -shared -o {{so}} "${objs[@]}" -ldl -lpthread

clean:
    rm -rf {{obj_dir}} {{so}}
